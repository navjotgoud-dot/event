# Database (Neon PostgreSQL recommended for production)
# Get connection string from https://neon.tech
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth
AUTH_SECRET="generate-a-long-random-string-here"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-string-here"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Business Plan Championship"

# Resend (Email)
# Get API key from https://resend.com
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@yourdomain.com"
RESEND_FROM_NAME="Business Plan Championship"

# Vercel Blob (File Storage) - REQUIRED for business plan & pitch deck uploads
# Create a Blob store at https://vercel.com/dashboard/stores → Create Database → Blob
# Then copy the BLOB_READ_WRITE_TOKEN
BLOB_READ_WRITE_TOKEN=""

# Cron secret for scheduled jobs
CRON_SECRET="generate-a-random-string"
